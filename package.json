{
  "name": "chiro-scribe",
  "private": true,
  "version": "0.1.0",
  "description": "Voice-to-form clinical documentation platform for chiropractic and sports rehab practices.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "verify": "pnpm format:check && pnpm lint && pnpm test",
    "forms": "node apps/onboarding/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
